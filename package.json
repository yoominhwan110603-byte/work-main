{
  "name": "vinyl-check",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "mobile:dev": "npm.cmd --prefix apps/mobile run dev",
    "mobile:build": "npm.cmd --prefix apps/mobile run build",
    "mobile:check": "cd apps/mobile && npx.cmd vue-tsc --noEmit",
    "mobile:sync": "npm.cmd --prefix apps/mobile run cap:sync",
    "android:debug": "cd apps/mobile/android && .\\gradlew.bat assembleDebug"
  }
}
